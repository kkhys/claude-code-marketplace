{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay",
            "args": ["/System/Library/Sounds/Hero.aiff"],
            "async": true,
            "timeout": 10,
            "statusMessage": "Playing notification sound..."
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/setup-worktree-env.sh",
            "timeout": 120,
            "statusMessage": "Setting up worktree environment..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay",
            "args": ["/System/Library/Sounds/Glass.aiff"],
            "async": true,
            "timeout": 10,
            "statusMessage": "Playing completion sound..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/cleanup-merged-branches.sh",
            "async": true,
            "timeout": 60,
            "statusMessage": "Cleaning up merged branches..."
          }
        ]
      }
    ]
  }
}
