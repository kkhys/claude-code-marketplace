{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "base",
  "displayName": "Base",
  "description": "Personal development workflow utilities for efficient knowledge management and automation",
  "version": "0.0.50",
  "author": {
    "name": "Keisuke Hayashi",
    "email": "hi@kkhys.me",
    "url": "https://github.com/kkhys"
  },
  "homepage": "https://github.com/kkhys/claude-code-marketplace",
  "repository": "https://github.com/kkhys/claude-code-marketplace",
  "license": "MIT",
  "keywords": ["git", "pull-request", "code-review", "memo", "automation", "writing", "japanese"],
  "agents": [
    "./skills/writing-japanese-tech-docs/agents/argument-auditor.md",
    "./skills/writing-japanese-tech-docs/agents/prose-auditor.md",
    "./skills/writing-japanese-tech-docs/agents/rhythm-designer.md",
    "./skills/writing-japanese-tech-docs/agents/technical-accuracy-checker.md"
